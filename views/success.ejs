<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Successful</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, Helvetica, sans-serif;
        }

        body{
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            background:#f4f6f9;
            padding:30px;
        }

        .card{
            width:450px;
            background:#ffffff;
            border-radius:18px;
            overflow:hidden;
            box-shadow:0 12px 30px rgba(0,0,0,.12);
        }

        .image-box{
            width:100%;
            height:300px;
            background:#e5e7eb;
        }

        .image-box img{
            width:100%;
            height:100%;
            object-fit:cover;
            display:block;
        }

        .content{
            padding:25px;
        }

        .badge{
            display:inline-block;
            background:#dcfce7;
            color:#15803d;
            padding:8px 14px;
            border-radius:20px;
            font-size:14px;
            font-weight:bold;
            margin-bottom:15px;
        }

        h2{
            color:#1f2937;
            margin-bottom:20px;
        }

        .details{
            border:1px solid #e5e7eb;
            border-radius:10px;
            overflow:hidden;
        }

        .row{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:14px 18px;
            border-bottom:1px solid #e5e7eb;
        }

        .row:last-child{
            border-bottom:none;
        }

        .label{
            font-weight:bold;
            color:#374151;
        }

        .value{
            color:#6b7280;
            text-align:right;
            max-width:55%;
            word-break:break-word;
        }

        .btn{
            display:block;
            width:100%;
            text-align:center;
            text-decoration:none;
            background:#2563eb;
            color:white;
            padding:14px;
            border-radius:10px;
            margin-top:25px;
            font-size:16px;
            font-weight:bold;
            transition:.3s;
        }

        .btn:hover{
            background:#1d4ed8;
        }

    </style>

</head>
<body>

    <div class="card">

        <div class="image-box">
            <img src="/uploads/<%= file.filename %>" alt="Uploaded Image">
        </div>

        <div class="content">

            <span class="badge">
                ✅ Upload Successful
            </span>

            <h2>Image Details</h2>

            <div class="details">

                <div class="row">
                    <span class="label">Original Name</span>
                    <span class="value"><%= file.originalname %></span>
                </div>

                <div class="row">
                    <span class="label">Stored Name</span>
                    <span class="value"><%= file.filename %></span>
                </div>

                <div class="row">
                    <span class="label">File Type</span>
                    <span class="value"><%= file.mimetype %></span>
                </div>

                <div class="row">
                    <span class="label">File Size</span>
                    <span class="value"><%= (file.size / 1024).toFixed(2) %> KB</span>
                </div>

            </div>

            <a href="/" class="btn">
                Upload Another Image
            </a>

        </div>

    </div>

</body>
</html>